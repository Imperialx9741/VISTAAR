dart_define.json

# Firebase configuration (ADR-0052) — FlutterFire CLI output, tied to
# the real "VISTAAR Production" project (vistaar-production-3a79a).
# Same never-in-git discipline this codebase already applies to every
# other provider credential (MSG91/S3/Sentry) — regenerate locally via
# `flutterfire configure` rather than committing these.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
