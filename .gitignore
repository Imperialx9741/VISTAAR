# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# IDE files
.idea/
.vscode/

# Local Python Environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Local database backups (pg_dump output) — never committed, these are
# point-in-time dumps of local/dev data, not source.
apps/backend/db_backups/
*.dump

# Local node packages
node_modules/
dist/
build/
.next/

# Real filled-in Kubernetes Secret manifests (ADR-0035) — only the
# .example.yaml templates under infrastructure/kubernetes/ belong in
# version control; a filled-in copy carries real production credentials.
infrastructure/kubernetes/*secret*.yaml
!infrastructure/kubernetes/*secret*.example.yaml

# Terraform local state/plugin artifacts (infrastructure/terraform/) —
# .terraform.lock.hcl is deliberately NOT ignored; it should be committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example