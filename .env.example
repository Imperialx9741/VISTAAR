# Application
APP_ENV=development
APP_NAME=vistaar
APP_VERSION=1.0.0

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS — origins the Admin Web (or any other browser frontend) is
# allowed to call this API from. Comma-separated for more than one.
# http://localhost:3000 is Next.js's own default dev port; update once
# a real admin-web deployment origin is decided (see
# infrastructure/kubernetes/backend-configmap.yaml).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database — port 5433, not Postgres's default 5432: docker-compose.dev.yml
# deliberately maps the dev Postgres container to host port 5433 (avoids
# colliding with any other local Postgres install on the standard port).
# Corrected 2026-09-08 — this template's own default was stale at 5432 and
# caused a real, hard-to-diagnose outage (every DB-touching request failing)
# once local `.env` loading was added; matches core/config.py's own default.
DATABASE_URL=postgresql://db_user:db_password@127.0.0.1:5433/vistaar_db

# Optional: overrides the database tests run against (default: derived
# from DATABASE_URL above, with the database name swapped to
# vistaar_test_db). Tests never run against DATABASE_URL directly — see
# apps/backend/tests/_integration_db.py.
# TEST_DATABASE_URL=postgresql://db_user:db_password@127.0.0.1:5433/vistaar_test_db

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Object Storage (ADR-0031) — AWS S3. Leave STORAGE_ENDPOINT blank to
# target real AWS S3 (boto3's default endpoint resolution); set it to
# point at any S3-compatible alternative instead (e.g. a local MinIO for
# dev, http://127.0.0.1:9000). STORAGE_ACCESS_KEY/SECRET_KEY must be real
# AWS credentials in production — the fake_* placeholders below only
# produce syntactically valid (not actually usable) presigned URLs.
STORAGE_ENDPOINT=
STORAGE_BUCKET=vistaar-storage
STORAGE_ACCESS_KEY=fake_access_key
STORAGE_SECRET_KEY=fake_secret_key
STORAGE_REGION=ap-south-1

# SMS (Phase 2 / Identity; ADR-0031) — "dev" (console log) is the
# default; set SMS_PROVIDER=msg91 + the two keys below for a real MSG91
# integration.
SMS_PROVIDER=dev
MSG91_AUTH_KEY=fake_msg91_auth_key
MSG91_TEMPLATE_ID=fake_msg91_template_id
# ADR-0034 (Notification Domain Foundation) — a separate Flow template
# for general notification SMS, distinct from the OTP template above.
# Blank by default; general notification SMS sends fail (recorded as a
# FAILED delivery, not a crash) until this is set to a real MSG91 Flow
# template ID.
MSG91_NOTIFICATION_TEMPLATE_ID=

# Push Notifications (ADR-0052) — "dev" (console log) is the default;
# set PUSH_PROVIDER=fcm + a real Firebase service-account credentials
# file path for a real FCM integration.
PUSH_PROVIDER=dev
FCM_SERVICE_ACCOUNT_JSON=

# Authentication
JWT_SECRET=placeholder_jwt_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Matching (Phase 3 / Task 3.2) — engineering configuration, not
# approved business values; see ADR-0011 and core/config.py.
MATCHING_SEARCH_RADIUS_KM=5
MATCHING_OFFER_TTL_SECONDS=20

# Payments — NOTE: this PAYMENT_PROVIDER block predates ADR-0025/
# ADR-0026's approved ride-fare model (customer pays the Sarthi directly,
# cash/UPI — VISTAAR never collects the ride fare) and is currently
# unused dead configuration; core/config.py declares it but no code
# reads it. Left as-is (not this task's scope to remove). Do not confuse
# it with WALLET_RECHARGE_PROVIDER below, which is a real, wired-up
# integration for a different purpose (a Sarthi topping up their own
# platform-fee wallet, not ride-fare collection).
PAYMENT_PROVIDER=stripe
PAYMENT_API_KEY=sk_test_fake_payment_api_key
PAYMENT_WEBHOOK_SECRET=whsec_fake_webhook_secret

# Sarthi Wallet Recharge (ADR-0060) — "dev" (console log, never actually
# verifies/credits) is the default; set WALLET_RECHARGE_PROVIDER=razorpay
# + the two Razorpay keys below for a real Razorpay TEST-mode
# integration. Razorpay here is a TESTING/DEVELOPMENT gateway only — the
# planned production gateway is SBI (ADR-0060 §5); this is NOT the ride
# fare payment (VISTAAR never collects ride fare — ADR-0025/ADR-0026),
# it only lets a Sarthi top up their own platform-fee wallet.
WALLET_RECHARGE_PROVIDER=dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret Razorpay signs webhook deliveries with (Razorpay
# dashboard → Webhooks) — distinct from RAZORPAY_KEY_SECRET, which
# signs the checkout/confirm flow instead.
RAZORPAY_WEBHOOK_SECRET=
# Minimum amount (INR) a Sarthi may recharge in one transaction.
WALLET_RECHARGE_MINIMUM_AMOUNT=200.00

# API Rate Limiting (ADR-0061, security.md §20) — application-level,
# per authenticated account (customer/driver/admin id), Redis-backed.
# Exact numbers are engineering configuration, not an approved business
# rule (security.md §89) — reasonable starting points, tune for real
# production traffic. RATE_LIMIT_ADMIN_API_PER_MINUTE is a single
# blanket limit across every /api/v1/admin/* endpoint, per admin
# account, per minute; every other RATE_LIMIT_* below is per hour.
RATE_LIMIT_RIDE_CREATE_PER_HOUR=20
RATE_LIMIT_RIDE_CANCEL_PER_HOUR=20
RATE_LIMIT_RIDE_OFFER_RESPONSE_PER_HOUR=60
RATE_LIMIT_FARE_CHANGE_PER_HOUR=20
RATE_LIMIT_WALLET_RECHARGE_PER_HOUR=10
RATE_LIMIT_PROMOTION_USAGE_PER_HOUR=20
RATE_LIMIT_REFERRAL_ATTACH_PER_HOUR=10
RATE_LIMIT_SUPPORT_MESSAGE_PER_HOUR=30
RATE_LIMIT_EVIDENCE_UPLOAD_PER_HOUR=30
RATE_LIMIT_ADMIN_API_PER_MINUTE=300

# Background Worker Foundation (ADR-0039) — Celery, using the same
# Redis instance as REDIS_URL above as both broker and result backend.
# No separate env var: shared/celery_app.py reads REDIS_URL directly.

# Notification expiry-warning schedules (ADR-0039 Decision 3) —
# engineering judgment, not a business value; how many days in advance
# to warn before a promotion/document expires.
PROMOTION_EXPIRY_WARNING_DAYS=3
DOCUMENT_EXPIRY_WARNING_DAYS=3

# Monitoring — Sentry (ADR-0053, 2026-08-28). Read directly by the
# backend (src/main.py's sentry_sdk.init()). Empty (the default) is
# sentry_sdk's own documented "disabled" state — no special-case code
# needed. SENTRY_TRACES_SAMPLE_RATE/SENTRY_PROFILES_SAMPLE_RATE/
# SENTRY_ENVIRONMENT already have their own working defaults in
# core/config.py (0.1/0.1/"development") and don't need to be set here
# unless overriding them.
SENTRY_DSN=

# Monitoring / Alerting (ADR-0053, alerting added 2026-09-03). Not read
# by the backend application itself — consumed directly by Alertmanager
# (infrastructure/docker/docker-compose.dev.yml locally,
# infrastructure/kubernetes/alertmanager-secret.example.yaml in
# production) to route firing/resolved alerts to Slack. Same
# "PROVIDER_PURPOSE" naming convention as every other credential above.
ALERTMANAGER_SLACK_WEBHOOK_URL=
