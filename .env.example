# Application
APP_ENV=development
APP_NAME=vistaar
APP_VERSION=1.0.0

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
DATABASE_URL=postgresql://db_user:db_password@127.0.0.1:5432/vistaar_db

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Object Storage
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=vistaar-storage
STORAGE_ACCESS_KEY=fake_access_key
STORAGE_SECRET_KEY=fake_secret_key

# Authentication
JWT_SECRET=placeholder_jwt_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Payments
PAYMENT_PROVIDER=stripe
PAYMENT_API_KEY=sk_test_fake_payment_api_key
PAYMENT_WEBHOOK_SECRET=whsec_fake_webhook_secret
